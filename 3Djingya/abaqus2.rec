    [mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[18], 
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[20], 
