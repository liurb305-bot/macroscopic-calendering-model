    , number=5)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].generateMesh(
    )
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].ConstrainedSketch(
    name='Roller_sketch', sheetSize=160.0)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].sketches['Roller_sketch'].CircleByCenterPerimeter(
    center=(0.0, 0.0), point1=(50.0, 0.0))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].Part(dimensionality=
    THREE_D, name='RigidRoller_CylindricalShell', type=DISCRETE_RIGID_SURFACE)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].BaseShellExtrude(
    depth=70.0, sketch=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].sketches['Roller_sketch'])
del mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].sketches['Roller_sketch']
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].Surface(
    name='ContactFace', side1Faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].faces)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].setElementType(
    elemTypes=(ElemType(elemCode=R3D4, elemLibrary=STANDARD), ), regions=(
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].faces, 
    ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].seedPart(
    deviationFactor=0.1, minSizeFactor=0.1, size=12.0)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'].generateMesh(
    )
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.DatumCsysByDefault(
    CARTESIAN)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Instance(
    dependent=ON, name='ActiveLayer-1', part=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Instance(
    dependent=ON, name='LowerRoller-1', part=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Instance(
    dependent=ON, name='UpperRoller-1', part=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['RigidRoller_CylindricalShell'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.rotate(
    angle=90.0, axisDirection=(0.0, 1.0, 0.0), axisPoint=(0.0, 0.0, 0.0), 
    instanceList=('LowerRoller-1', 'UpperRoller-1'))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.translate(
    instanceList=('LowerRoller-1', ), vector=(0.0, -50.0, 0.0))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.translate(
    instanceList=('UpperRoller-1', ), vector=(0.0, 50.15, 0.0))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.ReferencePoint(
    point=(0.0, 50.15, 0.0))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.ReferencePoint(
    point=(0.0, -50.0, 0.0))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Set(name=
    'RP_UpperRoller', referencePoints=(
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.referencePoints[8], 
    ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Set(name=
    'RP_LowerRoller', referencePoints=(
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.referencePoints[9], 
    ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Set(
    cells=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['ActiveLayer-1'].cells
    , name='Sheet_All')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Surface(
    name='Sheet_Top', side1Faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['ActiveLayer-1'].faces.getSequenceFromMask(
    mask=('[#12088 ]', ), ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Surface(
    name='Sheet_Bottom', side1Faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['ActiveLayer-1'].faces.getSequenceFromMask(
    mask=('[#40904 ]', ), ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Surface(
    name='UpperRoller_Contact', side1Faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['UpperRoller-1'].faces)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Surface(
    name='LowerRoller_Contact', side1Faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['LowerRoller-1'].faces)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Set(
    faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['ActiveLayer-1'].faces.getSequenceFromMask(
    mask=('[#c050 ]', ), ), name='Sheet_XSymFace')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.Set(
    faces=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['ActiveLayer-1'].faces.getSequenceFromMask(
    mask=('[#100000 ]', ), ), name='Sheet_ZSymFace')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].ContactProperty(name=
    'Contact_Roller_Active_mu0p1')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].interactionProperties['Contact_Roller_Active_mu0p1'].NormalBehavior(
    allowSeparation=ON, constraintEnforcementMethod=DEFAULT, 
    pressureOverclosure=HARD)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].interactionProperties['Contact_Roller_Active_mu0p1'].TangentialBehavior(
    dependencies=0, directionality=ISOTROPIC, formulation=PENALTY, fraction=
    0.005, maximumElasticSlip=FRACTION, pressureDependency=OFF, 
    slipRateDependency=OFF, table=((0.1, ), ), temperatureDependency=OFF)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].RigidBody(bodyRegion=
    Region(
    faces=mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['UpperRoller-1'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), )), name='Rigid_UpperRoller', refPointRegion=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_UpperRoller'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].RigidBody(bodyRegion=
    Region(
    faces=mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.instances['LowerRoller-1'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), )), name='Rigid_LowerRoller', refPointRegion=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_LowerRoller'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].SurfaceToSurfaceContactStd(
    createStepName='Initial', interactionProperty='Contact_Roller_Active_mu0p1'
    , main=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.surfaces['UpperRoller_Contact']
    , name='Contact_UpperRoller_SheetTop', secondary=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.surfaces['Sheet_Top']
    , sliding=FINITE, thickness=ON)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].SurfaceToSurfaceContactStd(
    createStepName='Initial', interactionProperty='Contact_Roller_Active_mu0p1'
    , main=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.surfaces['LowerRoller_Contact']
    , name='Contact_LowerRoller_SheetBottom', secondary=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.surfaces['Sheet_Bottom']
    , sliding=FINITE, thickness=ON)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].StaticStep(initialInc=
    0.01, maxInc=0.05, maxNumInc=300, minInc=1e-08, name='Press_Down', nlgeom=
    ON, previous='Initial')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].SmoothStepAmplitude(
    data=((0.0, 0.0), (1.0, 1.0)), name='Amp_Upper_Drop', timeSpan=STEP)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].DisplacementBC(
    createStepName='Initial', name='BC_Lower_RP_Fixed', region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_LowerRoller']
    , u1=0.0, u2=0.0, u3=0.0, ur1=0.0, ur2=0.0, ur3=0.0)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].DisplacementBC(
    createStepName='Initial', name='BC_Upper_RP_Guide', region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_UpperRoller']
    , u1=0.0, u2=UNSET, u3=0.0, ur1=UNSET, ur2=0.0, ur3=0.0)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].DisplacementBC(
    amplitude='Amp_Upper_Drop', createStepName='Press_Down', name=
    'BC_Upper_RP_Drop', region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_UpperRoller']
    , u1=UNSET, u2=-0.015, u3=UNSET, ur1=UNSET, ur2=UNSET, ur3=UNSET)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].XsymmBC(
    createStepName='Initial', name='BC_Sheet_XSym', region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['Sheet_XSymFace'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].ZsymmBC(
    createStepName='Initial', name='BC_Sheet_ZSym', region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['Sheet_ZSymFace'])
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].fieldOutputRequests['F-Output-1'].suppress(
    )
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].FieldOutputRequest(
    createStepName='Press_Down', name='F_Sheet_StressStrainContact', 
    numIntervals=40, region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['Sheet_All']
    , variables=('S', 'LE', 'PE', 'PEEQ', 'U', 'RF', 'CSTRESS', 'CSTATUS'))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].HistoryOutputRequest(
    createStepName='Press_Down', name='H_UpperRoller_RP', numIntervals=100, 
    region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_UpperRoller']
    , variables=('RF1', 'RF2', 'RF3', 'RM1', 'RM2', 'RM3', 'U1', 'U2', 'U3', 
    'UR1'))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].HistoryOutputRequest(
    createStepName='Press_Down', name='H_LowerRoller_RP', numIntervals=100, 
    region=
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].rootAssembly.sets['RP_LowerRoller']
    , variables=('RF1', 'RF2', 'RF3', 'RM1', 'RM2', 'RM3', 'U1', 'U2', 'U3', 
    'UR1'))
mdb.Job(description=
    'Local static symmetric normal press model with rigid rollers', model=
    'RollPress_Static_LocalSym_50mm_RigidRoller', multiprocessingMode=DEFAULT, 
    name='RollPress_Static_LocalSym_50mm_RigidRoller', nodalOutputPrecision=
    SINGLE, numCpus=6, type=ANALYSIS)
#* 域的个数必须是用于域计算的处理器个数的倍数.
