    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[12], 
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[29]]
    , size=1.5)
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].seedEdgeBySize(
