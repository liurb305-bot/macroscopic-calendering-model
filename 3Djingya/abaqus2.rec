mdb.Model(modelType=STANDARD_EXPLICIT, name=
    'RollPress_Static_LocalSym_50mm_RigidRoller')
del mdb.models['Model-1']
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].Material(name=
    'ActiveLayer_Porous_Calibratable')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].materials['ActiveLayer_Porous_Calibratable'].Density(
    table=((2.55e-09, ), ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].materials['ActiveLayer_Porous_Calibratable'].Elastic(
    table=((6500.0, 0.01), ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].materials['ActiveLayer_Porous_Calibratable'].CapPlasticity(
    table=((0.0032, 5.0, 0.8, 0.048, 0.02, 1.0), ))
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].materials['ActiveLayer_Porous_Calibratable'].capPlasticity.CapHardening(
    table=((0.048, 0.0), (0.0496, 0.05), (0.0528, 0.1), (0.0576, 0.15), (0.064, 
    0.18), (0.072, 0.2), (0.088, 0.22), (0.112, 0.24), (0.152, 0.26), (0.216, 
