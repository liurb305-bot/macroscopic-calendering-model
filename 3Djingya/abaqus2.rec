    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].faces.getSequenceFromMask(
    mask=('[#100000 ]', ), ), name='ZSymFace')
mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].setElementType(
