    [mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[0], 
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[2], 
