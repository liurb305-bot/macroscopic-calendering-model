    [mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[1], 
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[3], 
    mdb.models['RollPress_Static_LocalSym_50mm_RigidRoller'].parts['ActiveLayer'].edges[8], 
